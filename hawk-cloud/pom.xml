<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>hawk</artifactId>
        <groupId>com.hawk</groupId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>hawk-cloud</artifactId>

    <!--
        分布式层的**唯一**可执行模块 —— 把原来云端的三个模块（cloud-indexer / cloud-recall /
        cloud-coordinator）合并成一个 jar，靠 hawk.cloud.role 决定启动时装配哪一套：

            text-indexer / vector-indexer → hawk.cloud.indexer
            text-recall  / vector-recall  → hawk.cloud.recall
            coordinator                   → hawk.cloud.coordinator

        为什么合并：三处部署本来就用**同一个镜像**、只差环境变量，分成三个产物只会让版本漂。
        为什么保留三个包：它们之间没有任何互相 import，包根也互不重叠；拍平到一个包会让
        SearchController / RegistryRegistrar / HealthController 等 8 组同名类撞车。
        装配由 CloudApplication + IndexerRole / RecallRole / CoordinatorRole 负责，
        **只扫描当前角色那一个包** —— 否则两个 POST /search 会一起注册，启动就失败。

        依赖是三者的并集。没被选中的角色不会实例化任何 bean，也不会加载 ONNX / JDBC，
        所以多出来的只是 jar 体积，不是运行成本。
    -->

    <dependencies>
        <!-- 索引链路 -->
        <dependency>
            <groupId>com.hawk</groupId>
            <artifactId>indexer</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <!-- 向量链路：indexer 已传递依赖 vector，这里仍显式声明 ——
             将来调 indexer 的依赖时，不必担心这里静默丢类。 -->
        <dependency>
            <groupId>com.hawk</groupId>
            <artifactId>vector</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <!-- 召回链路 -->
        <dependency>
            <groupId>com.hawk</groupId>
            <artifactId>recall</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <!-- 协调器实际只用 JDK + fastjson + JRegistry，但合并后同一个模块共用依赖表，
             留着声明以保持与原 cloud-coordinator 的依赖面一致。 -->
        <dependency>
            <groupId>com.hawk</groupId>
            <artifactId>core</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 注册中心客户端。版本不在父 pom 统一管理，就地声明。 -->
        <dependency>
            <groupId>io.github.noobcodergrowing</groupId>
            <artifactId>JRegistryClient</artifactId>
            <version>1.0.6</version>
        </dependency>

        <!-- HTTP 层的 JSON 换成 fastjson（见各角色包下的 FastJsonWebConfig）。 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>fastjson</artifactId>
        </dependency>

        <!-- 连 MySQL 用的 JDBC 驱动（data-source.type=mysql 时）。 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!-- source/target/release 由父 pom 的 maven.compiler.release 统一管理 -->
            </plugin>
            <!-- 打成可执行胖 jar：
                 java -jar hawk-cloud/target/hawk-cloud-1.0-SNAPSHOT.jar
                 开发时也可 mvn -pl hawk-cloud spring-boot:run -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>hawk.cloud.CloudApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
