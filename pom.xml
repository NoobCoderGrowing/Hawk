<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hawk</groupId>
    <artifactId>hawk</artifactId>
    <packaging>pom</packaging>
    <version>1.0-SNAPSHOT</version>
    <modules>
        <module>indexer</module>
        <module>segment</module>
        <module>recall</module>
        <module>core</module>
        <module>demo</module>
        <module>benchmark</module>
        <module>vector</module>
        <module>web</module>
    </modules>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 4.x 才支持 JDK 25：
             2.7.11 的 ASM 读不了 class 文件 major 69，组件扫描阶段就抛
             "Unsupported class file major version 69"；3.x（Spring Framework 6.2）
             官方只支持到 JDK 24。Spring Framework 7 才以 Java 25 为目标。
             升级后 web 模块可以按 pom 里统一的 release 25 编译，不再需要降级覆盖。 -->
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <properties>
        <!-- FFM (java.lang.foreign / MemorySegment) 需要 JDK 22+，用 25 LTS。
             用 release 而非 source/target：保证不会意外链到更高版本才有的 API。 -->
        <maven.compiler.release>25</maven.compiler.release>
        <lombok.version>1.18.38</lombok.version>
    </properties>

<!--
    以前这里是 <dependencies>，会**无条件被所有子模块继承**，导致每个模块都背上
    Spring Boot Web / MyBatis / MySQL / fastjson / lz4 —— 连完全用不到的模块也一样。
    更严重的是：vector 模块在这个 classpath 下加载 ONNX Runtime 的原生库会段错误
    （多个 jar 的组合触发，具体机制未定位）。

    现在改为 <dependencyManagement>：只统一**版本**，各模块按需显式声明。
    这是 Maven 的标准做法，代价是每个模块要多写几行。
-->
<!--    dependencyManagement中项目选择继承,及子项目必须写明dependency才继承-->
    <dependencyManagement>
        <dependencies>
            <!-- === 只剩本项目模块真正用到的第三方依赖 === -->
            <!-- Spring Boot 自己的制品（spring-boot-starter*、jackson、logback、slf4j 等）
                 不在这里列：spring-boot-starter-parent 已经在管版本。
                 在子 pom 的 dependencyManagement 里写**无版本**条目不会回落到父级，
                 反而会让 Maven 报 "version is missing"。 -->

            <!-- segment 用它取 com.mysql.jdbc.StringUtils（不是 JDBC 驱动用途） -->
            <dependency>
                <groupId>mysql</groupId>
                <artifactId>mysql-connector-java</artifactId>
                <version>5.1.12</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <!-- 1.18.22 无法在 JDK 25 的 javac 上跑注解处理，会静默不生成 @Data/@Slf4j 成员 -->
                <version>${lombok.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>fastjson</artifactId>
                <version>1.2.75</version>
            </dependency>
            <dependency>
                <groupId>org.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>1.8.0</version>
            </dependency>
            <!-- jackson-databind 不在这里声明：spring-boot-starter-parent 已经在管它的版本，
                 在这里再写一条**无版本的**条目会让 Maven 报 "version is missing"，
                 因为子 pom 自己 dependencyManagement 里的条目不会回落到父级 -->

            <!--
                已移除（都无模块使用，且版本停留在 Spring Boot 2.x 时代）：
                  · org.mybatis.spring.boot:mybatis-spring-boot-starter:2.3.0
                  · org.springframework.cloud:spring-cloud-dependencies:2021.0.7
                  · com.alibaba.cloud:spring-cloud-alibaba-dependencies:2021.0.1.0
                  · com.ctrip.framework.apollo:apollo-client:1.7.0
                它们只是版本声明、不参与构建，但升到 Spring Boot 4 之后已彻底对不上，
                留着会误导后来想接 MyBatis / Spring Cloud 的人。要用时按 Boot 4 的兼容版本重新引。
            -->

        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <!-- JDK 23 起 javac 不再隐式运行"仅在 classpath 上"的注解处理器，
                             会让 Lombok 与 JMH 的 annotation processor 一起静默失效
                             （表现为找不到 @Data/@Slf4j 成员、benchmarks.jar 缺 BenchmarkList，
                             且没有任何 processor 相关报错提示）。
                             -proc:full 恢复 JDK 21 之前的行为：扫描 classpath 上的处理器。 -->
                        <proc>full</proc>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>