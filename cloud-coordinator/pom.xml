<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>hawk</artifactId>
        <groupId>com.hawk</groupId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>cloud-coordinator</artifactId>

    <!--
        独立 Spring Boot 服务：对外暴露协调用的 HTTP 接口。

        包名用 hawk.cloud.coordinator —— artifactId 里的连字符不能出现在 Java 包名里；
        冠以 hawk.cloud 前缀是为了和 cloud-indexer / cloud-recall 共用一个命名空间
        （hawk.indexer / hawk.recall 已被现有库模块占用，不能再跨 jar 分裂同一个包）。
        配置文件名同理用 hawk-cloud-coordinator.yml：见下面 main 类里的说明。

        依赖 core 拿到索引/文档的公共模型；如果本模块只做纯协调、不碰索引，
        可以去掉这条依赖，减少传递进来的 lz4 / fastjson / mysql-connector。
    -->

    <dependencies>
        <dependency>
            <groupId>com.hawk</groupId>
            <artifactId>core</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <!-- 版本由 spring-boot-starter-parent 管理 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 注册中心客户端：与 recall 的 JFST 同源，版本不在父 pom 统一管理，就地声明 -->
        <dependency>
            <groupId>io.github.noobcodergrowing</groupId>
            <artifactId>JRegistryClient</artifactId>
            <version>1.0.4</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!-- source/target/release 由父 pom 的 maven.compiler.release 统一管理 -->
            </plugin>
            <!-- 打成可执行胖 jar，与 web 模块一致。
                 run: java -jar cloud-coordinator/target/cloud-coordinator-1.0-SNAPSHOT.jar
                 开发时也可 mvn -pl cloud-coordinator spring-boot:run -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>hawk.cloud.coordinator.CoordinatorApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
