<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>hawk</artifactId>
        <groupId>com.hawk</groupId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>web</artifactId>

    <!--
        以前这里有一条 <maven.compiler.release>17</maven.compiler.release> 覆盖，
        把本模块单独降级编译 —— 因为 Spring Boot 2.7.11 的 ASM 读不了 class 69（JDK 25）。

        升到 Spring Boot 4.1.1 / Spring Framework 7 之后不再需要：它原生支持 JDK 25，
        本模块跟着父 pom 的 release 25 走即可。
    -->

    <!--
        检索演示台：Spring Boot 后端 + React 前端。

        只依赖 recall —— 倒排检索（Searcher / StringQuery / doc）。

        原先它还依赖 vector，是唯一同时接两条召回链路的模块，页面上有两个 tab。
        向量那一路已移除（vector 模块正在重建，见 VECTOR_MODULE_REBUILD.md），
        现在只有全文搜索。接回来时应当复用重建后的 VectorSearcher，
        而不是像以前那样在这里自己读 .npy、自己建 HNSW。

        前端源码在 web/frontend/，Vite 构建产物输出到
        web/src/main/resources/static/，由 Spring Boot 直接托管。
    -->

    <dependencies>
        <dependency>
            <groupId>com.hawk</groupId>
            <artifactId>recall</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <!--
            原先这里还有 com.hawk:vector —— 本模块曾是唯一同时依赖两条召回链路的模块。
            向量那一路已移除（见 SearchService 的类注释），依赖随之删掉。
            等 vector 模块重建完（VECTOR_MODULE_REBUILD.md）再按新的 VectorSearcher 接回来。
        -->

        <!-- 版本由 spring-boot-starter-parent 管理 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- HTTP 层的 JSON 换成 fastjson（见 FastJsonWebConfig）。版本由父 pom 管理。 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>fastjson</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <!--
                打成可执行胖 jar。父 pom 是 spring-boot-starter-parent 4.1.1，
                它的 pluginManagement 已预绑定 repackage 执行，这里声明插件即可。

                （早先不走这条路：Boot 2.7.11 内置的 ASM 读不了 JDK 25 字节码
                  （major 69），repackage 直接失败。升到 Boot 4 后该障碍已不存在。）

                原先那套「copy-dependencies 平铺到 target/dependency/ 再拼 classpath」
                已取消，现在直接跑 target/web-1.0-SNAPSHOT.jar。
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>hawk.web.WebApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
