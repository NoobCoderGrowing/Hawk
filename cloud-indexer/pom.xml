<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>hawk</artifactId>
        <groupId>com.hawk</groupId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>cloud-indexer</artifactId>

    <!--
        索引服务的云端形态：把 indexer 库包一层 Spring Boot HTTP 接口，
        并作为索引节点向注册中心登记。包名 hawk.cloud.indexer ——
        hawk.indexer 已被 indexer 库模块占用，不能再跨 jar 分裂同一个包。
    -->

    <dependencies>
        <dependency>
            <groupId>com.hawk</groupId>
            <artifactId>indexer</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <!-- 版本由 spring-boot-starter-parent 管理 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 注册中心客户端：与 recall 的 JFST 同源，版本不在父 pom 统一管理，就地声明 -->
        <dependency>
            <groupId>io.github.noobcodergrowing</groupId>
            <artifactId>JRegistryClient</artifactId>
            <version>1.0.4</version>
        </dependency>

        <!-- HTTP 层的 JSON 换成 fastjson（见 FastJsonWebConfig）。此前只是 JRegistryClient
             的传递依赖，本模块直接用了 fastjson 的类，所以显式声明。版本由父 pom 管理。 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>fastjson</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!-- source/target/release 由父 pom 的 maven.compiler.release 统一管理 -->
            </plugin>
            <!-- 打成可执行胖 jar，与 web 模块一致。
                 run: java -jar cloud-indexer/target/cloud-indexer-1.0-SNAPSHOT.jar
                 开发时也可 mvn -pl cloud-indexer spring-boot:run -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>hawk.cloud.indexer.IndexerApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
