<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>hawk</artifactId>
        <groupId>com.hawk</groupId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>vector</artifactId>

    <!--
        向量索引 SDK —— 与 indexer 定位一致：单机、单进程、无分片的索引器，
        只不过它把文本变成**向量索引**而不是倒排。

        骨架照抄 indexer：
          indexer.writer.IndexWriter           ↔ vector.writer.VectorIndexWriter
          indexer.writer.config.IndexConfig    ↔ vector.writer.config.VectorIndexConfig
          segment 的 Analyzer（文本→词项）      ↔ vector.model.TextEncoder（文本→向量）
          recall.search.Searcher               ↔ vector.search.VectorSearcher
          recall.search.ScoreDoc               ↔ vector.search.VectorHit

        因此**依赖 core**（document.Document / field.Field / directory.PkMapStore 都在那里）。
        这条依赖取代了原先"本模块不依赖 Hawk 任何模块"的约定：输入模型要和 indexer 共用，
        主键映射要复用 directory 的既有格式。core 是最底层模块，无框架依赖。
    -->

    <properties>
        <!-- 推理制品。默认 CPU 版（任何机器都能跑）；要 GPU 用 -Pgpu 换成 CUDA 版。
             这里插值的是 artifactId —— 两个制品同版本、同 API，只有原生库不同。 -->
        <onnxruntime.artifact>onnxruntime</onnxruntime.artifact>
        <onnxruntime.version>1.30.0</onnxruntime.version>
    </properties>

    <dependencies>
        <!-- 输入模型（Document / Field）与主键映射（PkMapStore）—— 与 indexer 共用同一套 -->
        <dependency>
            <groupId>com.hawk</groupId>
            <artifactId>core</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <!-- 推理。-Pgpu 换成 onnxruntime_gpu（约 670 MB，且要求宿主机有 CUDA 12 运行时） -->
        <dependency>
            <groupId>com.microsoft.onnxruntime</groupId>
            <artifactId>${onnxruntime.artifact}</artifactId>
            <version>${onnxruntime.version}</version>
        </dependency>

        <!-- 分词：JNI 封装 Rust 的 tokenizers，直接读 tokenizer.json，
             原生支持 WordPiece / BPE / Unigram —— 「任意模型权重」的关键 -->
        <dependency>
            <groupId>ai.djl.huggingface</groupId>
            <artifactId>tokenizers</artifactId>
            <version>0.38.0</version>
        </dependency>

        <!-- ANN 索引：纯 Java，无 JNI。HNSW + 磁盘驻留 + PQ/BQ 量化 -->
        <dependency>
            <groupId>io.github.jbellis</groupId>
            <artifactId>jvector</artifactId>
            <version>4.0.1</version>
        </dependency>

        <!-- 读 model.json 描述符。用 fastjson 而非 Jackson。
             原来这里是显式声明的 jackson-databind，项目代码改用 fastjson 后已移除 ——
             依赖树显示没有别的依赖传递带来它，所以若 jvector 等内部需要 Jackson，
             这一移除会暴露出来；向量检索的实跑已验证通过。
             版本由父 pom 的管理段统一指定。 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>fastjson</artifactId>
        </dependency>

        <!-- 日志：**不引 log4j**，用 logback。
             原来这里靠"父 pom 的 <dependencies> 被子模块继承"拿到 spring-boot-starter-logging，
             但根 pom 已把 <dependencies> 改成 <dependencyManagement>（只统一版本、不再无条件继承），
             于是本模块运行时**没有任何 SLF4J 实现**，启动时会打印
             "SLF4J: Defaulting to no-operation (NOP) logger implementation"，jvector 的日志也进不了 logback。
             所以这里显式声明。

             为什么只引 logback-classic：
               · logback-classic  → SLF4J 的实现（与 slf4j-api 天然配对）
               · jul-to-slf4j     → 让 java.util.logging 能转到 SLF4J
               · log4j-to-slf4j   → 桥接 log4j2 API
             再引 log4j-core 会变成两个 SLF4J binding，反而冲突。

             注意 jul-to-slf4j **光在 classpath 上不生效**，还需在启动时调用
             SLF4JBridgeHandler.install()；否则 JUL 的记录（如 jvector 的
             PhysicalCoreExecutor）仍按 JUL 原始格式打到控制台，绕开 logback。
             目前未安装，只影响这类启动期的少量 INFO 行。
             日志级别在 src/main/resources/logback.xml 里配 —— logback 在没有配置文件时
             用的是 **DEBUG** 级内置默认，DJL 与 jvector 会刷大量逐条日志，必须显式压下来。 -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>jul-to-slf4j</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <!--
            构建：mvn -pl vector -am -Pgpu package

            换成 onnxruntime_gpu，通过 ${onnxruntime.artifact} 生效。

            ⚠️ GPU 版**不打包 CUDA 运行时**。实测（ldd）CUDA EP 依赖宿主机提供
               libcudart.so.12 / libcublas.so.12 / libcublasLt.so.12 / libcurand.so.10
               （cuDNN 已静态链接进那个 597 MB 的 .so）。
               缺了这些库，addCUDA() 会抛 OrtException —— OnnxDevice 会按配置回退到 CPU。

            若不便在宿主机装 CUDA 12，可把库集中到一个目录，用
               VectorIndexConfig.setCudaLibDir(Path)
               让 OnnxDevice 在建设备前 System.load 预加载（免设 LD_LIBRARY_PATH）。
        -->
        <profile>
            <id>gpu</id>
            <properties>
                <onnxruntime.artifact>onnxruntime_gpu</onnxruntime.artifact>
            </properties>
        </profile>
    </profiles>

</project>
